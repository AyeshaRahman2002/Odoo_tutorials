<?xml version = "1.0" encoding = "UTF-8"?>
<odoo>

    <record id = "view_palmate_property_tree" model = "ir.ui.view">
        <field name = "name">palmate.property.tree</field>
        <field name = "model">palmate.property</field>
        <field name = "arch" type = "xml">
            <list string = "Properties">
                <field name = "name"/>
                <field name = "property_type"/>
                <field name = "location"/>
                <field name = "owner_id"/>
                <field name = "agent_id"/>
                <field name = "status"/>
                <field name = "price"/>
                <field name = "company_id"/>
            </list>
        </field>
    </record>

    <record id = "view_palmate_property_form" model = "ir.ui.view">
        <field name = "name">palmate.property.form</field>
        <field name = "model">palmate.property</field>
        <field name = "arch" type="xml">
            <form string = "Property">
                <header>
                    <button name = "action_mark_reserved"
                            string = "Mark Reserved"
                            type = "object"
                            class = "btn-primary"
                            invisible = "status != 'available'"/>
                    <button name = "action_mark_available"
                            string = "Mark Available"
                            type = "object"
                            invisible = "status == 'available'"/>
                    <field name = "status" widget = "statusbar"
                           statusbar_visible = "available,reserved,sold,rented"/>
                </header>

                <sheet>
                    <div class = "oe_title">
                        <h1>
                            <field name = "name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name = "property_type"/>
                            <field name = "location"/>
                            <field name = "owner_id"/>
                            <field name = "agent_id"/>
                        </group>
                        <group>
                            <field name = "price"/>
                            <field name = "currency_id"/>
                            <field name = "company_id"/>
                            <field name = "visit_count" readonly = "1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string = "Notes">
                            <field name = "notes"/>
                        </page>
                        <page string = "Visits">
                            <field name = "visit_ids">
                                <list editable = "bottom">
                                    <field name = "name"/>
                                    <field name = "customer_id"/>
                                    <field name = "agent_id"/>
                                    <field name = "visit_date"/>
                                    <field name = "status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id = "view_palmate_property_search" model = "ir.ui.view">
        <field name = "name">palmate.property.search</field>
        <field name = "model">palmate.property</field>
        <field name = "arch" type = "xml">
            <search string = "Search Properties">
                <field name = "name"/>
                <field name = "location"/>
                <field name = "owner_id"/>
                <field name = "agent_id"/>
                <filter name = "available" string = "Available"
                        domain = "[('status', ' = ', 'available')]"/>
                <filter name = "reserved" string = "Reserved"
                        domain = "[('status', ' = ', 'reserved')]"/>
                <filter name = "sold" string = "Sold"
                        domain = "[('status', ' = ', 'sold')]"/>
                <filter name = "rented" string = "Rented"
                        domain = "[('status', ' = ', 'rented')]"/>
                <group expand = "0" string = "Group By">
                    <filter name = "group_by_status" string = "Status"
                            context = "{'group_by': 'status'}"/>
                    <filter name = "group_by_agent" string = "Agent"
                            context = "{'group_by': 'agent_id'}"/>
                    <filter name = "group_by_type" string = "Property Type"
                            context = "{'group_by': 'property_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id = "action_palmate_property" model = "ir.actions.act_window">
        <field name = "name">Properties</field>
        <field name = "res_model">palmate.property</field>
        <field name = "view_mode">list,form</field>
    </record>

    <menuitem id = "menu_palmate_real_estate_root"
              name = "Palmate Real Estate"
              sequence = "10"/>

    <menuitem id = "menu_palmate_property"
              name = "Properties"
              parent = "menu_palmate_real_estate_root"
              action = "action_palmate_property"
              sequence = "10"/>

</odoo>