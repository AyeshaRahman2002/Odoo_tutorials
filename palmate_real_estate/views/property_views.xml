<?xml version = "1.0" encoding = "UTF-8"?>
<odoo>

    <record id = "view_palmate_property_tree" model = "ir.ui.view">
        <field name = "name">palmate.property.tree</field>
        <field name = "model">palmate.property</field>
        <field name = "arch" type = "xml">
            <list string = "Properties">
                <field name = "property_image" widget = "image" optional = "hide"/>
                <field name = "name"/>
                <field name = "property_type"/>
                <field name = "location"/>
                <field name = "owner_id"/>
                <field name = "agent_id"/>
                <field name = "status"/>
                <field name = "price"/>
                <field name = "company_id"/>
            </list>
        </field>
    </record>

    <record id = "view_palmate_property_kanban" model = "ir.ui.view">
        <field name = "name">palmate.property.kanban</field>
        <field name = "model">palmate.property</field>
        <field name = "arch" type = "xml">
            <kanban class = "o_palmate_property_kanban o_kanban_mobile"
                    quick_create = "false"
                    group_create = "0"
                    records_draggable = "0">
                <field name = "name"/>
                <field name = "property_type"/>
                <field name = "location"/>
                <field name = "price"/>
                <field name = "currency_id"/>
                <field name = "agent_id"/>
                <field name = "status"/>
                <field name = "visit_count"/>
                <field name = "inquiry_count"/>
                <field name = "active_reservation_count"/>
                <field name = "property_image"/>
                <templates>
                    <t t-name = "card">
                        <div class = "oe_kanban_global_click o_kanban_record o_palmate_kanban_card">
                            <div class = "o_palmate_kanban_media">
                                <field name = "property_image" widget = "image" options = "{'size': [0, 220]}"/>
                            </div>
                            <div class = "o_kanban_record_body">
                                <div class = "o_palmate_kanban_header">
                                    <strong class = "o_kanban_record_title">
                                        <field name = "name"/>
                                    </strong>
                                    <span class = "badge rounded-pill text-bg-light">
                                        <field name = "status"/>
                                    </span>
                                </div>
                                <div class = "text-muted">
                                    <field name = "property_type"/>
                                </div>
                                <div class = "text-muted">
                                    <i class = "fa fa-map-marker me-1" title = "Location"/>
                                    <field name = "location"/>
                                </div>
                                <div class = "o_palmate_price">
                                    <field name = "price"/>
                                </div>
                                <div class = "text-muted">
                                    <field name = "agent_id"/>
                                </div>
                                <div class = "o_palmate_metrics">
                                    <span>Visits: <field name = "visit_count"/></span>
                                    <span>Inquiries: <field name = "inquiry_count"/></span>
                                    <span>Open Reservations: <field name = "active_reservation_count"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id = "view_palmate_property_form" model = "ir.ui.view">
        <field name = "name">palmate.property.form</field>
        <field name = "model">palmate.property</field>
        <field name = "arch" type = "xml">
            <form string = "Property">
                <header>
                    <button name = "action_generate_ai_description"
                            string = "Generate Discription"
                            type = "object"
                            class = "btn-secondary"/>
                    <button name = "action_publish_property"
                            string = "Publish Property"
                            type = "object"
                            class = "btn-primary"
                            invisible = "status != 'draft'"/>
                    <button name = "action_reserve_property"
                            string = "Reserve Property"
                            type = "object"
                            invisible = "status != 'available'"/>
                    <button name = "action_mark_sold"
                            string = "Mark Sold"
                            type = "object"
                            invisible = "status not in ('available', 'reserved')"/>
                    <button name = "action_mark_rented"
                            string = "Mark Rented"
                            type = "object"
                            invisible = "status not in ('available', 'reserved')"/>
                    <button name = "action_archive_property"
                            string = "Archive"
                            type = "object"
                            invisible = "status == 'archived'"/>
                    <field name = "status" widget = "statusbar"
                           options = "{'clickable': 0}"
                           statusbar_visible = "draft,available,reserved,sold,rented,archived"/>
                </header>

                <sheet>
                    <div class = "oe_button_box" name = "button_box">
                        <button name = "action_view_visits" type = "object" class = "oe_stat_button" icon = "fa-calendar">
                            <field name = "visit_count" string = "Visits" widget = "statinfo"/>
                        </button>
                        <button name = "action_view_inquiries" type = "object" class = "oe_stat_button" icon = "fa-comments">
                            <field name = "inquiry_count" string = "Inquiries" widget = "statinfo"/>
                        </button>
                        <button name = "action_view_reservations" type = "object" class = "oe_stat_button" icon = "fa-bookmark">
                            <field name = "reservation_count" string = "Reservations" widget = "statinfo"/>
                        </button>
                        <button name = "action_view_contracts" type = "object" class = "oe_stat_button" icon = "fa-file-text-o">
                            <field name = "contract_count" string = "Contracts" widget = "statinfo"/>
                        </button>
                        <button name = "action_view_maintenance_requests" type = "object" class = "oe_stat_button" icon = "fa-wrench">
                            <field name = "maintenance_count" string = "Maintenance" widget = "statinfo"/>
                        </button>
                    </div>

                    <div class = "oe_title">
                        <h1>
                            <field name = "name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name = "property_image" widget = "image" class = "oe_avatar"
                                   options = "{'preview_image': 'property_image'}"/>
                            <field name = "property_type"/>
                            <field name = "location"/>
                            <field name = "owner_id"/>
                            <field name = "agent_id"/>
                        </group>
                        <group>
                            <field name = "price"/>
                            <field name = "currency_id"/>
                            <field name = "company_id"/>
                            <field name = "visit_count" readonly = "1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string = "Description">
                            <field name = "ai_description" placeholder = "Use the button above to generate a draft description."/>
                        </page>
                        <page string = "Notes">
                            <field name = "notes"/>
                        </page>
                        <page string = "Documents">
                            <group>
                                <group>
                                    <field name = "title_deed_file" filename = "title_deed_filename"/>
                                    <field name = "title_deed_filename" invisible = "1"/>
                                </group>
                                <group>
                                    <field name = "brochure_file" filename = "brochure_filename"/>
                                    <field name = "brochure_filename" invisible = "1"/>
                                </group>
                            </group>
                        </page>
                        <page string = "Inquiries">
                            <field name = "inquiry_ids" context = "{'default_property_id': id}">
                                <list>
                                    <field name = "name"/>
                                    <field name = "customer_id"/>
                                    <field name = "preferred_location"/>
                                    <field name = "budget"/>
                                    <field name = "property_type"/>
                                    <field name = "agent_id"/>
                                    <field name = "source"/>
                                    <field name = "status"/>
                                </list>
                            </field>
                        </page>
                        <page string = "Visits">
                            <field name = "visit_ids" context = "{'default_property_id': id}">
                                <list>
                                    <field name = "name"/>
                                    <field name = "inquiry_id"/>
                                    <field name = "customer_id"/>
                                    <field name = "agent_id"/>
                                    <field name = "visit_date"/>
                                    <field name = "status"/>
                                </list>
                            </field>
                        </page>
                        <page string = "Reservations">
                            <field name = "reservation_ids" context = "{'default_property_id': id}">
                                <list>
                                    <field name = "name"/>
                                    <field name = "inquiry_id"/>
                                    <field name = "visit_id"/>
                                    <field name = "customer_id"/>
                                    <field name = "agent_id"/>
                                    <field name = "reservation_date"/>
                                    <field name = "expiry_date"/>
                                    <field name = "deposit_amount"/>
                                    <field name = "status"/>
                                </list>
                            </field>
                        </page>
                        <page string = "Contracts">
                            <field name = "contract_ids" context = "{'default_property_id': id}">
                                <list>
                                    <field name = "name"/>
                                    <field name = "inquiry_id"/>
                                    <field name = "reservation_id"/>
                                    <field name = "visit_id"/>
                                    <field name = "customer_id"/>
                                    <field name = "agent_id"/>
                                    <field name = "contract_type"/>
                                    <field name = "start_date"/>
                                    <field name = "amount"/>
                                    <field name = "status"/>
                                </list>
                            </field>
                        </page>
                        <page string = "Maintenance">
                            <field name = "maintenance_request_ids" context = "{'default_property_id': id}">
                                <list>
                                    <field name = "name"/>
                                    <field name = "tenant_id"/>
                                    <field name = "issue_type"/>
                                    <field name = "priority"/>
                                    <field name = "assigned_partner_id"/>
                                    <field name = "status"/>
                                    <field name = "cost"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id = "view_palmate_property_search" model = "ir.ui.view">
        <field name = "name">palmate.property.search</field>
        <field name = "model">palmate.property</field>
        <field name = "arch" type = "xml">
            <search>
                <field name = "name"/>
                <field name = "location"/>
                <field name = "owner_id"/>
                <field name = "agent_id"/>
                <filter name = "draft" string = "Draft" domain = "[('status', '=', 'draft')]"/>
                <filter name = "available" string = "Available" domain = "[('status', '=', 'available')]"/>
                <filter name = "reserved" string = "Reserved" domain = "[('status', '=', 'reserved')]"/>
                <filter name = "sold" string = "Sold" domain = "[('status', '=', 'sold')]"/>
                <filter name = "rented" string = "Rented" domain = "[('status', '=', 'rented')]"/>
                <filter name = "archived" string = "Archived" domain = "[('status', '=', 'archived')]"/>
                <filter name = "group_by_status" string = "Status" context = "{'group_by': 'status'}"/>
                <filter name = "group_by_agent" string = "Agent" context = "{'group_by': 'agent_id'}"/>
                <filter name = "group_by_type" string = "Property Type" context = "{'group_by': 'property_type'}"/>
            </search>
        </field>
    </record>

    <record id = "view_palmate_property_pivot" model = "ir.ui.view">
        <field name = "name">palmate.property.pivot</field>
        <field name = "model">palmate.property</field>
        <field name = "arch" type = "xml">
            <pivot string = "Properties Analysis">
                <field name = "status" type = "row"/>
                <field name = "property_type" type = "col"/>
                <field name = "price" type = "measure"/>
            </pivot>
        </field>
    </record>

    <record id = "view_palmate_property_graph" model = "ir.ui.view">
        <field name = "name">palmate.property.graph</field>
        <field name = "model">palmate.property</field>
        <field name = "arch" type = "xml">
            <graph string = "Properties by Status" type = "bar">
                <field name = "status"/>
            </graph>
        </field>
    </record>

    <record id = "action_palmate_property" model = "ir.actions.act_window">
        <field name = "name">Properties</field>
        <field name = "res_model">palmate.property</field>
        <field name = "view_mode">kanban,list,form,pivot,graph</field>
        <field name = "context">{'search_default_group_by_status': 1}</field>
    </record>

    <record id = "action_palmate_property_reporting" model = "ir.actions.act_window">
        <field name = "name">Property Reporting</field>
        <field name = "res_model">palmate.property</field>
        <field name = "view_mode">pivot,graph,list</field>
        <field name = "context">{'search_default_group_by_status': 1}</field>
    </record>

    <menuitem id = "menu_palmate_real_estate_root"
              name = "Palmate Real Estate"
              action = "action_palmate_dashboard"
              sequence = "10"/>

    <menuitem id = "menu_palmate_property"
              name = "Properties"
              parent = "menu_palmate_real_estate_root"
              action = "action_palmate_property"
              sequence = "10"/>

    <menuitem id = "menu_palmate_property_reporting"
              name = "Property Reporting"
              parent = "menu_palmate_real_estate_root"
              action = "action_palmate_property_reporting"
              sequence = "60"/>

</odoo>
