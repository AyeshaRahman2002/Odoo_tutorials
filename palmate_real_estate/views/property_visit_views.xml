<?xml version = "1.0" encoding = "UTF-8"?>
<odoo>

    <record id = "view_palmate_property_visit_tree" model = "ir.ui.view">
        <field name = "name">palmate.property.visit.tree</field>
        <field name = "model">palmate.property.visit</field>
        <field name = "arch" type = "xml">
            <list string = "Property Visits">
                <field name = "name"/>
                <field name = "inquiry_id"/>
                <field name = "property_id"/>
                <field name = "customer_id"/>
                <field name = "agent_id"/>
                <field name = "visit_date"/>
                <field name = "status"/>
                <field name = "preferred_location" optional = "hide"/>
                <field name = "preferred_budget" optional = "hide"/>
                <field name = "preferred_property_type" optional = "hide"/>
                <field name = "company_id"/>
            </list>
        </field>
    </record>

    <record id = "view_palmate_property_visit_form" model = "ir.ui.view">
        <field name = "name">palmate.property.visit.form</field>
        <field name = "model">palmate.property.visit</field>
        <field name = "arch" type = "xml">
            <form string = "Property Visit">
                <header>
                    <button name = "action_send_visit_email"
                            string = "Send Visit Email"
                            type = "object"
                            class = "btn-secondary"/>
                    <button name = "action_suggest_matching_properties"
                            string = "Suggest Matching Properties"
                            type = "object"
                            class = "btn-secondary"/>
                    <button name = "action_create_reservation"
                            string = "Create Reservation"
                            type = "object"
                            invisible = "status not in ('interested', 'offer_sent', 'closed')"/>
                    <button name = "action_complete"
                            string = "Mark Completed"
                            type = "object"
                            class = "btn-primary"
                            invisible = "status !=  'scheduled'"/>
                    <button name = "action_mark_interested"
                            string = "Mark Interested"
                            type = "object"
                            invisible = "status not in ('completed', 'offer_sent')"/>
                    <button name = "action_send_offer"
                            string = "Send Offer"
                            type = "object"
                            invisible = "status != 'interested'"/>
                    <button name = "action_close"
                            string = "Close"
                            type = "object"
                            invisible = "status != 'offer_sent'"/>
                    <button name = "action_mark_lost"
                            string = "Mark Lost"
                            type = "object"
                            invisible = "status in ('closed', 'lost', 'cancelled')"/>
                    <button name = "action_cancel"
                            string = "Cancel"
                            type = "object"
                            invisible = "status == 'cancelled'"/>
                    <button name = "action_reset_to_scheduled"
                            string = "Reset to Scheduled"
                            type = "object"
                            invisible = "status == 'scheduled'"/>
                    <field name = "status" widget = "statusbar"
                           statusbar_visible = "scheduled,completed,interested,offer_sent,closed,lost,cancelled"/>
                </header>

                <sheet>
                    <div class = "oe_button_box" name = "button_box">
                        <button name = "action_create_reservation"
                                type = "object"
                                class = "oe_stat_button"
                                icon = "fa-bookmark">
                            <span class = "o_stat_text">Create Reservation</span>
                        </button>
                    </div>

                    <div class = "oe_title">
                        <h1>
                            <field name = "name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name = "inquiry_id"/>
                            <field name = "property_id"/>
                            <field name = "customer_id"/>
                            <field name = "agent_id"/>
                        </group>
                        <group>
                            <field name = "visit_date"/>
                            <field name = "currency_id"/>
                            <field name = "company_id"/>
                        </group>
                    </group>

                    <group string = "Customer Requirements">
                        <group>
                            <field name = "preferred_location"/>
                            <field name = "preferred_property_type"/>
                        </group>
                        <group>
                            <field name = "preferred_budget"/>
                        </group>
                    </group>

                    <group>
                        <field name = "feedback"/>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_palmate_property_visit_search" model="ir.ui.view">
        <field name="name">palmate.property.visit.search</field>
        <field name="model">palmate.property.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="inquiry_id"/>
                <field name="property_id"/>
                <field name="customer_id"/>
                <field name="agent_id"/>
                <filter name="scheduled" string="Scheduled" domain="[('status', '=', 'scheduled')]"/>
                <filter name="completed" string="Completed" domain="[('status', '=', 'completed')]"/>
                <filter name="interested" string="Interested" domain="[('status', '=', 'interested')]"/>
                <filter name="offer_sent" string="Offer Sent" domain="[('status', '=', 'offer_sent')]"/>
                <filter name="closed" string="Closed" domain="[('status', '=', 'closed')]"/>
                <filter name="lost" string="Lost" domain="[('status', '=', 'lost')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('status', '=', 'cancelled')]"/>
                <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                <filter name="group_by_agent" string="Agent" context="{'group_by': 'agent_id'}"/>
                <filter name="group_by_inquiry" string="Inquiry" context="{'group_by': 'inquiry_id'}"/>
                <filter name="group_by_property" string="Property" context="{'group_by': 'property_id'}"/>
            </search>
        </field>
    </record>

    <record id = "view_palmate_property_visit_pivot" model = "ir.ui.view">
        <field name = "name">palmate.property.visit.pivot</field>
        <field name = "model">palmate.property.visit</field>
        <field name = "arch" type = "xml">
            <pivot string = "Visit Analysis">
                <field name = "agent_id" type = "row"/>
                <field name = "status" type = "col"/>
            </pivot>
        </field>
    </record>

    <record id = "view_palmate_property_visit_graph" model = "ir.ui.view">
        <field name = "name">palmate.property.visit.graph</field>
        <field name = "model">palmate.property.visit</field>
        <field name = "arch" type = "xml">
            <graph string = "Visits by Agent" type = "bar">
                <field name = "agent_id"/>
            </graph>
        </field>
    </record>

    <record id = "action_palmate_property_visit" model = "ir.actions.act_window">
        <field name = "name">Property Visits</field>
        <field name = "res_model">palmate.property.visit</field>
        <field name = "view_mode">list,form,pivot,graph</field>
    </record>

    <record id = "action_palmate_property_visit_reporting" model = "ir.actions.act_window">
        <field name = "name">Visit Reporting</field>
        <field name = "res_model">palmate.property.visit</field>
        <field name = "view_mode">pivot,graph,list</field>
        <field name = "context">{'search_default_group_by_agent': 1}</field>
    </record>

    <menuitem id = "menu_palmate_property_visit_reporting"
              name = "Visit Reporting"
              parent = "menu_palmate_real_estate_root"
              action = "action_palmate_property_visit_reporting"
              sequence = "70"/>

</odoo>
