                <button name="action_view_property_reservations" type="object" class="oe_stat_button" icon="fa-bookmark">
                    <field name="property_reservation_count" string="Reservations" widget="statinfo"/>
                </button>
                <button name="action_view_property_contracts" type="object" class="oe_stat_button" icon="fa-file-text-o">
                    <field name="property_contract_count" string="Contracts" widget="statinfo"/>
