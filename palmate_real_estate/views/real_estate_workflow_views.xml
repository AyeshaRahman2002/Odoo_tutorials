<?xml version = "1.0" encoding = "UTF-8"?>
<odoo>

    <record id = "view_palmate_property_inquiry_tree" model = "ir.ui.view">
        <field name = "name">palmate.property.inquiry.tree</field>
        <field name = "model">palmate.property.inquiry</field>
        <field name = "arch" type = "xml">
            <list string = "Property Inquiries">
                <field name = "name"/>
                <field name = "customer_id"/>
                <field name = "property_id"/>
                <field name = "crm_lead_id" optional = "hide"/>
                <field name = "preferred_location"/>
                <field name = "budget"/>
                <field name = "property_type"/>
                <field name = "agent_id"/>
                <field name = "source"/>
                <field name = "priority"/>
                <field name = "followup_date"/>
                            <field name = "probability"/>
                            <field name = "lost_reason" invisible = "status != 'lost'"/>
                            <field name = "status"/>
            </list>
        </field>
    </record>

    <record id = "view_palmate_property_inquiry_form" model = "ir.ui.view">
        <field name = "name">palmate.property.inquiry.form</field>
        <field name = "model">palmate.property.inquiry</field>
        <field name = "arch" type = "xml">
            <form string = "Property Inquiry">
                <header>
                    <button name = "action_create_crm_opportunity" string = "Create CRM Opportunity" type = "object"
                            class = "btn-secondary" invisible = "crm_lead_id"/>
                    <button name = "action_view_crm_opportunity" string = "Open CRM Opportunity" type = "object"
                            class = "btn-secondary" invisible = "not crm_lead_id"/>
                    <button name = "action_send_inquiry_email" string = "Send Inquiry Email" type = "object"
                            class = "btn-secondary"/>
                    <button name = "action_qualify" string = "Qualify" type = "object" class = "btn-primary"
                            invisible = "status != 'inquiry'"/>
                    <button name = "action_schedule_visit" string = "Schedule Visit" type = "object"
                            invisible = "status not in ('qualified', 'inquiry')"/>
                    <button name = "action_create_visit" string = "Create Visit" type = "object"
                            invisible = "status not in ('qualified', 'visit_scheduled', 'offer_sent')"/>
                    <button name = "action_send_offer" string = "Send Offer" type = "object"
                            invisible = "status not in ('qualified', 'visit_scheduled')"/>
                    <button name = "action_create_reservation" string = "Create Reservation" type = "object"
                            invisible = "status not in ('visit_scheduled', 'offer_sent')"/>
                    <button name = "action_mark_won" string = "Mark Won" type = "object"
                            invisible = "status == 'won'"/>
                    <button name = "action_mark_lost" string = "Mark Lost" type = "object"
                            invisible = "status in ('won', 'lost')"/>
                    <field name = "status" widget = "statusbar"
                           options = "{'clickable': 0}"
                           statusbar_visible = "inquiry,qualified,visit_scheduled,offer_sent,won,lost"/>
                </header>

                <sheet>
                    <div class = "oe_button_box" name = "button_box">
                        <button name = "action_view_crm_opportunity" type = "object" class = "oe_stat_button" icon = "fa-crosshairs"
                                invisible = "not crm_lead_id">
                            <span class = "o_stat_text">CRM Opportunity</span>
                        </button>
                        <button name = "action_view_visits" type = "object" class = "oe_stat_button" icon = "fa-calendar">
                            <field name = "visit_count" string = "Visits" widget = "statinfo"/>
                        </button>
                        <button name = "action_view_reservations" type = "object" class = "oe_stat_button" icon = "fa-bookmark">
                            <field name = "reservation_count" string = "Reservations" widget = "statinfo"/>
                        </button>
                        <button name = "action_view_contracts" type = "object" class = "oe_stat_button" icon = "fa-file-text-o">
                            <field name = "contract_count" string = "Contracts" widget = "statinfo"/>
                        </button>
                    </div>

                    <div class = "oe_title">
                        <h1><field name = "name"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name = "customer_id"/>
                            <field name = "property_id"/>
                            <field name = "agent_id"/>
                            <field name = "crm_lead_id" readonly = "1"/>
                            <field name = "priority"/>
                        </group>
                        <group>
                            <field name = "source"/>
                            <field name = "followup_date"/>
                            <field name = "overdue_followup" readonly = "1"/>
                            <field name = "expected_close_date"/>
                            <field name = "probability"/>
                            <field name = "lost_reason" invisible = "status != 'lost'"/>
                            <field name = "currency_id"/>
                            <field name = "company_id"/>
                        </group>
                    </group>

                    <group string = "Requirements">
                        <group>
                            <field name = "preferred_location"/>
                            <field name = "property_type"/>
                        </group>
                        <group>
                            <field name = "budget"/>
                        </group>
                    </group>

                    <notebook>
                        <page string = "Notes">
                            <field name = "notes"/>
                        </page>
                        <page string = "Visits">
                            <field name = "visit_ids" context = "{'default_inquiry_id': id}">
                                <list>
                                    <field name = "name"/>
                                    <field name = "property_id"/>
                                    <field name = "customer_id"/>
                                    <field name = "agent_id"/>
                                    <field name = "visit_date"/>
                                    <field name = "status"/>
                                </list>
                            </field>
                        </page>
                        <page string = "Reservations">
                            <field name = "reservation_ids" context = "{'default_inquiry_id': id}">
                                <list>
                                    <field name = "name"/>
                                    <field name = "visit_id"/>
                                    <field name = "property_id"/>
                                    <field name = "customer_id"/>
                                    <field name = "agent_id"/>
                                    <field name = "reservation_date"/>
                                    <field name = "status"/>
                                </list>
                            </field>
                        </page>
                        <page string = "Contracts">
                            <field name = "contract_ids" context = "{'default_inquiry_id': id}">
                                <list>
                                    <field name = "name"/>
                                    <field name = "reservation_id"/>
                                    <field name = "visit_id"/>
                                    <field name = "property_id"/>
                                    <field name = "customer_id"/>
                                    <field name = "agent_id"/>
                                    <field name = "contract_type"/>
                                    <field name = "status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id = "view_palmate_property_inquiry_search" model = "ir.ui.view">
        <field name = "name">palmate.property.inquiry.search</field>
        <field name = "model">palmate.property.inquiry</field>
        <field name = "arch" type = "xml">
            <search>
                <field name = "name"/>
                <field name = "customer_id"/>
                <field name = "property_id"/>
                <field name = "agent_id"/>
                <filter name = "status_inquiry" string = "Inquiry" domain = "[('status', '=', 'inquiry')]"/>
                <filter name = "status_qualified" string = "Qualified" domain = "[('status', '=', 'qualified')]"/>
                <filter name = "status_visit_scheduled" string = "Visit Scheduled" domain = "[('status', '=', 'visit_scheduled')]"/>
                <filter name = "status_offer_sent" string = "Offer Sent" domain = "[('status', '=', 'offer_sent')]"/>
                <filter name = "status_won" string = "Won" domain = "[('status', '=', 'won')]"/>
                <filter name = "status_lost" string = "Lost" domain = "[('status', '=', 'lost')]"/>
                <filter name = "overdue_followup" string = "Overdue Follow-up" domain = "[('overdue_followup', '=', True)]"/>
                <filter name = "group_by_status" string = "Status" context = "{'group_by': 'status'}"/>
                <filter name = "group_by_source" string = "Source" context = "{'group_by': 'source'}"/>
                <filter name = "group_by_agent" string = "Agent" context = "{'group_by': 'agent_id'}"/>
            </search>
        </field>
    </record>

    <record id = "action_palmate_property_inquiry" model = "ir.actions.act_window">
        <field name = "name">Property Inquiries</field>
        <field name = "res_model">palmate.property.inquiry</field>
        <field name = "view_mode">list,form</field>
    </record>

    <record id = "view_palmate_property_reservation_tree" model = "ir.ui.view">
        <field name = "name">palmate.property.reservation.tree</field>
        <field name = "model">palmate.property.reservation</field>
        <field name = "arch" type = "xml">
            <list string = "Property Reservations">
                <field name = "name"/>
                <field name = "inquiry_id"/>
                <field name = "visit_id"/>
                <field name = "property_id"/>
                <field name = "customer_id"/>
                <field name = "agent_id"/>
                <field name = "reservation_date"/>
                <field name = "expiry_date"/>
                <field name = "days_to_expiry"/>
                <field name = "extension_requested" optional = "hide"/>
                <field name = "extension_approved" optional = "hide"/>
                <field name = "deposit_amount"/>
                <field name = "status"/>
            </list>
        </field>
    </record>

    <record id = "view_palmate_property_reservation_form" model = "ir.ui.view">
        <field name = "name">palmate.property.reservation.form</field>
        <field name = "model">palmate.property.reservation</field>
        <field name = "arch" type = "xml">
            <form string = "Property Reservation">
                <header>
                    <button name = "action_send_reservation_email" string = "Send Reservation Email" type = "object"
                            class = "btn-secondary"/>
                    <button name = "action_create_contract" string = "Create Contract" type = "object"
                            invisible = "status in ('cancelled', 'expired')"/>
                    <button name = "action_request_extension" string = "Request Extension" type = "object"
                            class = "btn-secondary" invisible = "status != 'active'"/>
                    <button name = "action_approve_extension" string = "Approve Extension" type = "object"
                            invisible = "not extension_requested"/>
                    <button name = "action_activate" string = "Activate" type = "object"
                            invisible = "status == 'active'"/>
                    <button name = "action_expire" string = "Expire" type = "object"
                            invisible = "status in ('expired', 'converted', 'cancelled')"/>
                    <button name = "action_convert" string = "Convert" type = "object"
                            invisible = "status in ('converted', 'cancelled')"/>
                    <button name = "action_cancel" string = "Cancel" type = "object"
                            invisible = "status == 'cancelled'"/>
                    <field name = "status" widget = "statusbar"
                           options = "{'clickable': 0}"
                           statusbar_visible = "active,expired,converted,cancelled"/>
                </header>

                <sheet>
                    <div class = "oe_button_box" name = "button_box">
                        <button name = "action_view_contracts" type = "object" class = "oe_stat_button" icon = "fa-file-text-o">
                            <field name = "contract_count" string = "Contracts" widget = "statinfo"/>
                        </button>
                    </div>

                    <div class = "oe_title">
                        <h1><field name = "name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name = "inquiry_id"/>
                            <field name = "visit_id"/>
                            <field name = "property_id"/>
                            <field name = "customer_id"/>
                            <field name = "agent_id"/>
                        </group>
                        <group>
                            <field name = "reservation_date"/>
                            <field name = "expiry_date"/>
                            <field name = "days_to_expiry" readonly = "1"/>
                            <field name = "expiring_soon" readonly = "1"/>
                            <field name = "extension_days"/>
                            <field name = "extension_requested" readonly = "1"/>
                            <field name = "extension_approved" readonly = "1"/>
                            <field name = "deposit_amount"/>
                        </group>
                    </group>
                    <group>
                        <field name = "notes"/>
                    </group>

                    <notebook>
                        <page string = "Contracts">
                            <field name = "contract_ids" context = "{'default_reservation_id': id}">
                                <list>
                                    <field name = "name"/>
                                    <field name = "visit_id"/>
                                    <field name = "inquiry_id"/>
                                    <field name = "property_id"/>
                                    <field name = "customer_id"/>
                                    <field name = "agent_id"/>
                                    <field name = "contract_type"/>
                                    <field name = "status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id = "action_palmate_property_reservation" model = "ir.actions.act_window">
        <field name = "name">Reservations</field>
        <field name = "res_model">palmate.property.reservation</field>
        <field name = "view_mode">list,form</field>
    </record>

    <record id = "view_palmate_property_contract_tree" model = "ir.ui.view">
        <field name = "name">palmate.property.contract.tree</field>
        <field name = "model">palmate.property.contract</field>
        <field name = "arch" type = "xml">
            <list string = "Property Contracts">
                <field name = "name"/>
                <field name = "inquiry_id"/>
                <field name = "reservation_id"/>
                <field name = "visit_id"/>
                <field name = "property_id"/>
                <field name = "customer_id"/>
                <field name = "agent_id"/>
                <field name = "contract_type"/>
                <field name = "start_date"/>
                <field name = "end_date"/>
                <field name = "amount"/>
                <field name = "paid_amount"/>
                <field name = "outstanding_amount"/>
                <field name = "payment_progress"/>
                <field name = "status"/>
            </list>
        </field>
    </record>

    <record id = "view_palmate_property_contract_form" model = "ir.ui.view">
        <field name = "name">palmate.property.contract.form</field>
        <field name = "model">palmate.property.contract</field>
        <field name = "arch" type = "xml">
            <form string = "Property Contract">
                <header>
                    <button name = "action_send_contract_email" string = "Send Contract Email" type = "object"
                            class = "btn-secondary"/>
                    <button name = "action_approve_discount" string = "Approve Discount" type = "object"
                            class = "btn-secondary" invisible = "discount_amount == 0 or discount_approved"/>
                    <button name = "action_create_all_invoices" string = "Generate All Invoices" type = "object"
                            class = "btn-secondary" invisible = "not payment_line_ids"/>
                    <button name = "action_sign" string = "Sign" type = "object"
                            class = "btn-primary" invisible = "status != 'draft'"/>
                    <button name = "action_activate" string = "Activate" type = "object"
                            invisible = "status != 'signed'"/>
                    <button name = "action_close" string = "Close" type = "object"
                            invisible = "status == 'closed'"/>
                    <field name = "status" widget = "statusbar"
                           options = "{'clickable': 0}"
                           statusbar_visible = "draft,signed,active,closed"/>
                </header>

                <sheet>
                    <div class = "oe_button_box" name = "button_box">
                        <button name = "action_view_invoices" type = "object" class = "oe_stat_button" icon = "fa-file-text-o">
                            <field name = "invoice_count" string = "Invoices" widget = "statinfo"/>
                        </button>
                        <button name = "action_view_payments" type = "object" class = "oe_stat_button" icon = "fa-money">
                            <field name = "payment_count" string = "Payments" widget = "statinfo"/>
                        </button>
                        <button name = "action_view_commissions" type = "object" class = "oe_stat_button" icon = "fa-percent">
                            <field name = "commission_count" string = "Commissions" widget = "statinfo"/>
                        </button>
                        <button name = "action_view_maintenance_requests" type = "object" class = "oe_stat_button" icon = "fa-wrench">
                            <field name = "maintenance_count" string = "Maintenance" widget = "statinfo"/>
                        </button>
                    </div>

                    <div class = "oe_title">
                        <h1><field name = "name"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name = "property_id"/>
                            <field name = "customer_id"/>
                            <field name = "agent_id"/>
                            <field name = "contract_type"/>
                        </group>
                        <group>
                            <field name = "start_date"/>
                            <field name = "end_date" invisible = "contract_type != 'rent'"/>
                            <field name = "amount"/>
                            <field name = "discount_amount"/>
                            <field name = "discount_approved" readonly = "1"/>
                            <field name = "net_amount" readonly = "1"/>
                            <field name = "booking_percent_required"/>
                            <field name = "required_booking_amount" readonly = "1"/>
                            <field name = "paid_amount" readonly = "1"/>
                            <field name = "outstanding_amount" readonly = "1"/>
                            <field name = "payment_progress" widget = "progressbar" readonly = "1"/>
                            <field name = "currency_id"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name = "visit_id"/>
                            <field name = "reservation_id"/>
                            <field name = "inquiry_id"/>
                        </group>
                        <group>
                            <field name = "company_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string = "Summary">
                            <field name = "payment_plan" placeholder = "Outline the overall deal structure or payment summary."/>
                        </page>
                        <page string = "Payment Plan">
                            <field name = "payment_line_ids">
                                <list>
                                    <field name = "name"/>
                                    <field name = "due_date"/>
                                    <field name = "amount"/>
                                    <field name = "paid"/>
                                    <field name = "payment_status"/>
                                    <field name = "invoice_id"/>
                                    <field name = "invoice_state"/>
                                </list>
                            </field>
                        </page>
                        <page string = "Commissions">
                            <field name = "commission_ids">
                                <list>
                                    <field name = "agent_id"/>
                                    <field name = "commission_percent"/>
                                    <field name = "commission_amount"/>
                                    <field name = "status"/>
                                </list>
                            </field>
                        </page>
                        <page string = "Maintenance">
                            <field name = "maintenance_request_ids" context = "{'default_contract_id': id, 'default_property_id': property_id, 'default_tenant_id': customer_id}">
                                <list>
                                    <field name = "name"/>
                                    <field name = "property_id"/>
                                    <field name = "tenant_id"/>
                                    <field name = "issue_type"/>
                                    <field name = "priority"/>
                                    <field name = "due_date"/>
                                    <field name = "overdue"/>
                                    <field name = "status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id = "view_palmate_property_contract_search" model = "ir.ui.view">
        <field name = "name">palmate.property.contract.search</field>
        <field name = "model">palmate.property.contract</field>
        <field name = "arch" type = "xml">
            <search>
                <field name = "name"/>
                <field name = "property_id"/>
                <field name = "customer_id"/>
                <field name = "agent_id"/>
                <filter name = "status_draft" string = "Draft" domain = "[('status', '=', 'draft')]"/>
                <filter name = "status_signed" string = "Signed" domain = "[('status', '=', 'signed')]"/>
                <filter name = "status_active" string = "Active" domain = "[('status', '=', 'active')]"/>
                <filter name = "status_closed" string = "Closed" domain = "[('status', '=', 'closed')]"/>
                <filter name = "group_by_type" string = "Contract Type" context = "{'group_by': 'contract_type'}"/>
                <filter name = "group_by_agent" string = "Agent" context = "{'group_by': 'agent_id'}"/>
            </search>
        </field>
    </record>

    <record id = "action_palmate_property_contract" model = "ir.actions.act_window">
        <field name = "name">Contracts</field>
        <field name = "res_model">palmate.property.contract</field>
        <field name = "view_mode">list,form</field>
    </record>

    <record id = "view_palmate_contract_payment_tree" model = "ir.ui.view">
        <field name = "name">palmate.contract.payment.tree</field>
        <field name = "model">palmate.contract.payment</field>
        <field name = "arch" type = "xml">
            <list string = "Payment Plan Lines">
                <field name = "contract_id"/>
                <field name = "name"/>
                <field name = "property_id"/>
                <field name = "customer_id"/>
                <field name = "agent_id"/>
                <field name = "inquiry_id" optional = "hide"/>
                <field name = "reservation_id" optional = "hide"/>
                <field name = "visit_id" optional = "hide"/>
                <field name = "due_date"/>
                <field name = "amount"/>
                <field name = "paid"/>
                <field name = "payment_status"/>
                <field name = "invoice_id"/>
                <field name = "invoice_state"/>
                <field name = "invoice_payment_state" optional = "hide"/>
                <field name = "days_overdue"/>
            </list>
        </field>
    </record>

    <record id = "view_palmate_contract_payment_form" model = "ir.ui.view">
        <field name = "name">palmate.contract.payment.form</field>
        <field name = "model">palmate.contract.payment</field>
        <field name = "arch" type = "xml">
            <form string = "Payment Plan Line">
                <header>
                    <button name = "action_create_invoice" string = "Create Invoice" type = "object"
                            class = "btn-primary" invisible = "invoice_id"/>
                    <button name = "action_view_invoice" string = "Open Invoice" type = "object"
                            class = "btn-secondary" invisible = "not invoice_id"/>
                </header>
                <sheet>
                    <div class = "oe_title">
                        <h1><field name = "name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name = "contract_id"/>
                            <field name = "property_id" readonly = "1"/>
                            <field name = "customer_id" readonly = "1"/>
                            <field name = "agent_id" readonly = "1"/>
                        </group>
                        <group>
                            <field name = "due_date"/>
                            <field name = "amount"/>
                            <field name = "paid"/>
                            <field name = "payment_status" readonly = "1"/>
                            <field name = "invoice_id" readonly = "1"/>
                            <field name = "invoice_state" readonly = "1"/>
                            <field name = "invoice_payment_state" readonly = "1"/>
                            <field name = "days_overdue" readonly = "1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name = "inquiry_id" readonly = "1"/>
                            <field name = "visit_id" readonly = "1"/>
                        </group>
                        <group>
                            <field name = "reservation_id" readonly = "1"/>
                            <field name = "company_id" readonly = "1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id = "view_palmate_contract_payment_search" model = "ir.ui.view">
        <field name = "name">palmate.contract.payment.search</field>
        <field name = "model">palmate.contract.payment</field>
        <field name = "arch" type = "xml">
            <search>
                <field name = "name"/>
                <field name = "contract_id"/>
                <field name = "property_id"/>
                <field name = "customer_id"/>
                <field name = "agent_id"/>
                <filter name = "pending" string = "Pending" domain = "[('payment_status', '=', 'pending')]"/>
                <filter name = "overdue" string = "Overdue" domain = "[('payment_status', '=', 'overdue')]"/>
                <filter name = "paid" string = "Paid" domain = "[('payment_status', '=', 'paid')]"/>
                <filter name = "invoiced" string = "Invoiced" domain = "[('invoice_id', '!=', False)]"/>
                <filter name = "group_by_contract" string = "Contract" context = "{'group_by': 'contract_id'}"/>
                <filter name = "group_by_agent" string = "Agent" context = "{'group_by': 'agent_id'}"/>
                <filter name = "group_by_status" string = "Payment Status" context = "{'group_by': 'payment_status'}"/>
            </search>
        </field>
    </record>

    <record id = "action_palmate_contract_payment" model = "ir.actions.act_window">
        <field name = "name">Payment Plans</field>
        <field name = "res_model">palmate.contract.payment</field>
        <field name = "view_mode">list,form</field>
    </record>

    <record id = "view_palmate_agent_commission_tree" model = "ir.ui.view">
        <field name = "name">palmate.agent.commission.tree</field>
        <field name = "model">palmate.agent.commission</field>
        <field name = "arch" type = "xml">
            <list string = "Agent Commissions">
                <field name = "agent_id"/>
                <field name = "contract_id"/>
                <field name = "property_id"/>
                <field name = "customer_id"/>
                <field name = "contract_type"/>
                <field name = "inquiry_id" optional = "hide"/>
                <field name = "reservation_id" optional = "hide"/>
                <field name = "visit_id" optional = "hide"/>
                <field name = "commission_percent"/>
                <field name = "commission_amount"/>
                <field name = "status"/>
            </list>
        </field>
    </record>

    <record id = "view_palmate_agent_commission_form" model = "ir.ui.view">
        <field name = "name">palmate.agent.commission.form</field>
        <field name = "model">palmate.agent.commission</field>
        <field name = "arch" type = "xml">
            <form string = "Agent Commission">
                <header>
                    <button name = "action_approve" string = "Approve" type = "object"
                            invisible = "status != 'pending'"/>
                    <button name = "action_mark_paid" string = "Mark Paid" type = "object"
                            invisible = "status == 'paid'"/>
                    <field name = "status" widget = "statusbar"
                           options = "{'clickable': 0}"
                           statusbar_visible = "pending,approved,paid"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name = "agent_id"/>
                            <field name = "contract_id"/>
                            <field name = "property_id" readonly = "1"/>
                            <field name = "customer_id" readonly = "1"/>
                        </group>
                        <group>
                            <field name = "contract_type" readonly = "1"/>
                            <field name = "commission_percent"/>
                            <field name = "commission_amount" readonly = "1"/>
                            <field name = "company_id" readonly = "1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name = "inquiry_id" readonly = "1"/>
                            <field name = "visit_id" readonly = "1"/>
                        </group>
                        <group>
                            <field name = "reservation_id" readonly = "1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id = "view_palmate_agent_commission_search" model = "ir.ui.view">
        <field name = "name">palmate.agent.commission.search</field>
        <field name = "model">palmate.agent.commission</field>
        <field name = "arch" type = "xml">
            <search>
                <field name = "agent_id"/>
                <field name = "contract_id"/>
                <field name = "property_id"/>
                <field name = "customer_id"/>
                <filter name = "pending" string = "Pending" domain = "[('status', '=', 'pending')]"/>
                <filter name = "approved" string = "Approved" domain = "[('status', '=', 'approved')]"/>
                <filter name = "paid" string = "Paid" domain = "[('status', '=', 'paid')]"/>
                <filter name = "group_by_agent" string = "Agent" context = "{'group_by': 'agent_id'}"/>
                <filter name = "group_by_status" string = "Status" context = "{'group_by': 'status'}"/>
                <filter name = "group_by_contract_type" string = "Contract Type" context = "{'group_by': 'contract_type'}"/>
            </search>
        </field>
    </record>

    <record id = "action_palmate_agent_commission" model = "ir.actions.act_window">
        <field name = "name">Commissions</field>
        <field name = "res_model">palmate.agent.commission</field>
        <field name = "view_mode">list,form</field>
    </record>

    <record id = "view_palmate_maintenance_request_tree" model = "ir.ui.view">
        <field name = "name">palmate.maintenance.request.tree</field>
        <field name = "model">palmate.maintenance.request</field>
        <field name = "arch" type = "xml">
            <list string = "Maintenance Requests">
                <field name = "name"/>
                <field name = "contract_id"/>
                <field name = "property_id"/>
                <field name = "tenant_id"/>
                <field name = "agent_id"/>
                <field name = "issue_type"/>
                <field name = "priority"/>
                <field name = "assigned_partner_id"/>
                <field name = "reported_date"/>
                <field name = "response_due_date"/>
                <field name = "response_overdue"/>
                <field name = "due_date"/>
                <field name = "overdue"/>
                <field name = "maintenance_app_request_id" optional = "hide"/>
                <field name = "completion_date"/>
                <field name = "status"/>
                <field name = "cost"/>
            </list>
        </field>
    </record>

    <record id = "view_palmate_maintenance_request_form" model = "ir.ui.view">
        <field name = "name">palmate.maintenance.request.form</field>
        <field name = "model">palmate.maintenance.request</field>
        <field name = "arch" type = "xml">
            <form string = "Maintenance Request">
                <header>
                    <button name = "action_sync_official_ticket_status" string = "Sync Official Status" type = "object"
                            class = "btn-secondary" invisible = "not maintenance_app_request_id"/>
                    <button name = "action_create_maintenance_app_request" string = "Create Official Ticket" type = "object"
                            class = "btn-secondary" invisible = "maintenance_app_request_id"/>
                    <button name = "action_view_maintenance_app_request" string = "Open Official Ticket" type = "object"
                            class = "btn-secondary" invisible = "not maintenance_app_request_id"/>
                    <button name = "action_start" string = "Start Work" type = "object"
                            invisible = "status != 'new'"/>
                    <button name = "action_done" string = "Mark Done" type = "object"
                            invisible = "status == 'done'"/>
                    <field name = "status" widget = "statusbar"
                           options = "{'clickable': 0}"
                           statusbar_visible = "new,in_progress,done"/>
                </header>

                <sheet>
                    <div class = "oe_title">
                        <h1><field name = "name"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name = "contract_id"/>
                            <field name = "property_id"/>
                            <field name = "tenant_id"/>
                            <field name = "agent_id" readonly = "1"/>
                            <field name = "maintenance_app_request_id" readonly = "1"/>
                            <field name = "issue_type"/>
                            <field name = "priority"/>
                        </group>
                        <group>
                            <field name = "assigned_partner_id"/>
                            <field name = "reported_date"/>
                            <field name = "response_due_date"/>
                            <field name = "response_overdue" readonly = "1"/>
                            <field name = "due_date"/>
                            <field name = "overdue" readonly = "1"/>
                            <field name = "official_ticket_done" readonly = "1"/>
                            <field name = "completion_date" readonly = "1"/>
                            <field name = "cost"/>
                            <field name = "currency_id"/>
                            <field name = "company_id"/>
                        </group>
                    </group>

                    <group>
                        <field name = "description"/>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id = "action_palmate_maintenance_request" model = "ir.actions.act_window">
        <field name = "name">Maintenance Requests</field>
        <field name = "res_model">palmate.maintenance.request</field>
        <field name = "view_mode">list,form</field>
    </record>

    <record id="view_res_partner_form_inherit_palmate_real_estate" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.palmate.real_estate</field>
        <field name="model">res.partner</field>
